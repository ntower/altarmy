{
  "name": "altarmy-tbc",
  "version": "2.2.11",
  "private": true,
  "description": "AltArmy — WoW TBC Classic addon (character summary, gear, search)",
  "scripts": {
    "setup:dev": "node scripts/setup-dev-tools.js",
    "typecheck": "node -e \"process.exit(0)\"",
    "check": "node scripts/run-luacheck.js AltArmy_TBC && node scripts/check-lua51-compile.js AltArmy_TBC",
    "lint": "node scripts/run-luacheck.js AltArmy_TBC",
    "check:compile": "node scripts/check-lua51-compile.js AltArmy_TBC",
    "test": "node scripts/run-busted.js",
    "dump:sync": "node scripts/sync-compare-dump.js",
    "prepare": "node scripts/install-git-hooks.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "crates:generate": "python scripts/generate-waylaid-crates.py",
    "crates:check": "python scripts/generate-waylaid-crates.py --check",
    "writs:generate": "python scripts/generate-writs.py",
    "writs:check": "python scripts/generate-writs.py --check"
  }
}
